# Mercado Pago Checkout Pro (fora do git).
# Produção: APP_USR-...  Teste: TEST-...
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
KLAVIYO_PRIVATE_KEY=
# Site ID público (6 caracteres). Só a newsletter usa Client Subscriptions.
KLAVIYO_PUBLIC_KEY=
# Newsletter: lista exclusiva "Newsletter Lua Nova" (double opt-in).
# Nunca usar o segmento Yz7AcS nem as listas de agenda/pagamento.
KLAVIYO_NEWSLETTER_LIST_ID=UZXm8g
# Reserva de e-mail de agenda — não usar a mesma lista da newsletter.
KLAVIYO_LIST_ID=
# true no ambiente local: a API não chama a Klaviyo.
KLAVIYO_DRY_RUN=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=Reino de Mulambo <contato@reinodemulambo.com>
HOST_NOTIFY_EMAIL=contato.maenatalia@gmail.com
CALCOM_WEBHOOK_SECRET=
